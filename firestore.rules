rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write for user profiles across devices and Netlify
    match /users/{userId} {
      allow read, write: if true;
    }

    // Allow read and write for blocks across devices and Netlify
    match /blocks/{blockId} {
      allow read, write: if true;
    }

    // Allow read and write for user themes
    match /themes/{userId} {
      allow read, write: if true;
    }

    // Platform settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Analytics events
    match /analytics/{eventId} {
      allow read, write: if true;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
